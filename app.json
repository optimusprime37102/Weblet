{
  "expo": {
    "name": "Weblet",
    "slug": "Weblet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "weblet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.weblet.app",
      "icon": "./assets/app-icon.png"
    },
    "android": {
      "icon": "./assets/app-icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#F9343E"
      },
      "package": "com.weblet.app",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "weblet",
              "host": "browser"
            },
            {
              "scheme": "weblet",
              "pathPrefix": "/browser"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F9343E",
          "dark": {
            "image": "./assets/app-icon.png",
            "backgroundColor": "#F9343E"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
